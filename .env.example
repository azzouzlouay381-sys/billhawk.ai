# .env.example — BillHawk AI environment variables
# ──────────────────────────────────────────────────────────────────────────────
# NOTE: In this project the OpenAI API key is hardcoded directly inside:
#   app/api/analyze-bill/route.ts
#
# This file is kept here as a reference / alternative approach.
# If you ever want to switch to environment variables (recommended for teams):
#   1. Uncomment the line below and fill in your key
#   2. Replace the hardcoded key in route.ts with: process.env.OPENAI_API_KEY
#   3. Add the variable to Netlify: Site Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# OPENAI_API_KEY=sk-...your-key-here...

# ──────────────────────────────────────────────────────────────────────────────
# To set variables on Netlify:
#   Netlify Dashboard → Your Site → Site configuration → Environment variables
#   → Add variable → Key: OPENAI_API_KEY  Value: sk-...
# ──────────────────────────────────────────────────────────────────────────────
